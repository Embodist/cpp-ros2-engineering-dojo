{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(colcon:*)",
      "Bash(ros2:*)",
      "Bash(ninja:*)",
      "Bash(make:*)",
      "Bash(g++:*)",
      "Bash(clang:*)",
      "Bash(clang-tidy:*)",
      "Bash(clang-format:*)",
      "Bash(python3 tools/train.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./docker/.env)",
      "Read(**/auth.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)"
    ]
  }
}
