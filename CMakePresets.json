      "output": {"outputOnFailure": true}
    },
    {
      "name": "projects",
      "configurePreset": "projects",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "projects-asan",
      "configurePreset": "projects-asan",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "projects-tsan",
      "configurePreset": "projects-tsan",
      "output": {"outputOnFailure": true}
    }
