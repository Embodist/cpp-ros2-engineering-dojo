      "#define dbgv(v) do { cerr << #v << \" = [\"; for (auto&& _e : (v)) cerr << _e << \", \"; cerr << \"]\\n\"; } while (0)",
      "#else",
      "#define dbg(x) ((void)0)",
      "#define dbgv(v) ((void)0)",
