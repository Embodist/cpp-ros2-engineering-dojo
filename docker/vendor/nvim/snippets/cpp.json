  "Binary Search": {
    "prefix": "!bs",
    "description": "手写二分：在 [lo, hi] 中找第一个满足条件的位置",
    "body": [
      "// [ref] 二分：找第一个满足 ok(mid) 的位置；注意 lo + (hi - lo) / 2 防溢出",
      "long long lo = ${1:0}, hi = ${2:n - 1}, ans = -1;",
      "while (lo <= hi) {",
      "\tlong long mid = lo + (hi - lo) / 2;",
      "\tif (${3:ok(mid)}) {",
      "\t\tans = mid;",
      "\t\thi = mid - 1;",
      "\t} else {",
      "\t\tlo = mid + 1;",
      "\t}",
      "}",
      "$0"
    ]
  },

  "GCD / LCM": {
    "prefix": "!gcd",
    "description": "gcd / lcm（C++17 std::gcd 已内置，此处为参考实现）",
    "body": [
      "// [ref] C++17 起可直接用 std::gcd / std::lcm",
      "long long gcd(long long a, long long b) { return b == 0 ? a : gcd(b, a % b); }",
      "long long lcm(long long a, long long b) { return a / gcd(a, b) * b; }",
      "$0"
    ]
  },

  "Disjoint Set Union": {
    "prefix": "!dsu",
    "description": "[ref] 并查集（路径压缩 + 按大小合并）",
    "body": [
      "// [ref] 并查集 — 请自己推导：为什么路径压缩后接近 O(alpha(n))",
      "struct DSU {",
      "\tvector<int> p, sz;",
      "\texplicit DSU(int n) : p(n), sz(n, 1) { iota(p.begin(), p.end(), 0); }",
      "\tint find(int x) { return p[x] == x ? x : p[x] = find(p[x]); }",
      "\tbool unite(int a, int b) {",
      "\t\ta = find(a); b = find(b);",
      "\t\tif (a == b) return false;",
      "\t\tif (sz[a] < sz[b]) swap(a, b);",
      "\t\tp[b] = a; sz[a] += sz[b];",
      "\t\treturn true;",
      "\t}",
      "};",
      "$0"
    ]
  },

  "Fenwick Tree": {
    "prefix": "!bit",
    "description": "[ref] 树状数组（单点加 / 前缀和）",
    "body": [
      "// [ref] 树状数组 — 请自己推导 i & -i 的含义",
      "struct BIT {",
      "\tint n;",
      "\tvector<long long> t;",
      "\texplicit BIT(int n) : n(n), t(n + 1, 0) {}",
      "\tvoid add(int i, long long v) { for (; i <= n; i += i & -i) t[i] += v; }",
      "\tlong long sum(int i) const { long long s = 0; for (; i > 0; i -= i & -i) s += t[i]; return s; }",
      "\tlong long range(int l, int r) const { return sum(r) - sum(l - 1); }",
      "};",
      "$0"
    ]
  },

  "Segment Tree": {
    "prefix": "!segtree",
    "description": "[ref] 线段树（区间和，点更新，迭代写法）",
    "body": [
      "// [ref] 线段树 — 先自己写递归版理解 pushup/pushdown，再用迭代版提速",
      "struct SegTree {",
      "\tint n;",
      "\tvector<long long> t;",
      "\texplicit SegTree(int n) : n(n), t(2 * n, 0) {}",
      "\tvoid set(int i, long long v) {",
      "\t\tfor (t[i += n] = v; i > 1; i >>= 1) t[i >> 1] = t[i] + t[i ^ 1];",
      "\t}",
      "\tlong long query(int l, int r) const {",
      "\t\tlong long s = 0;",
      "\t\tfor (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "\t\t\tif (l & 1) s += t[l++];",
      "\t\t\tif (r & 1) s += t[--r];",
      "\t\t}",
      "\t\treturn s;",
      "\t}",
      "};",
      "$0"
    ]
  },

  "Dijkstra": {
    "prefix": "!dijkstra",
    "description": "[ref] Dijkstra 最短路（邻接表 + 优先队列）",
    "body": [
      "// [ref] Dijkstra — 思考：为什么不能处理负权边？",
      "vector<long long> dijkstra(int s, const vector<vector<pair<int, int>>>& g) {",
      "\tconst long long INF = LLONG_MAX / 4;",
      "\tvector<long long> d(g.size(), INF);",
      "\tpriority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<>> pq;",
      "\td[s] = 0;",
      "\tpq.emplace(0, s);",
      "\twhile (!pq.empty()) {",
      "\t\tauto [du, u] = pq.top(); pq.pop();",
      "\t\tif (du != d[u]) continue;",
      "\t\tfor (auto [v, w] : g[u]) {",
      "\t\t\tif (du + w < d[v]) {",
      "\t\t\t\td[v] = du + w;",
      "\t\t\t\tpq.emplace(d[v], v);",
      "\t\t\t}",
      "\t\t}",
      "\t}",
      "\treturn d;",
      "}",
      "$0"
    ]
  },

