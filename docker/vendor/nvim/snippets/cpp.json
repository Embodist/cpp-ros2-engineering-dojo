      "",
      "void solve() {",
      "\t$0",
      "}",
      "",
      "int main() {",
      "\tios::sync_with_stdio(false);",
      "\tcin.tie(nullptr);",
      "",
      "\tint t = 1;",
      "\t// cin >> t;",
      "\twhile (t--) solve();",
      "\treturn 0;",
