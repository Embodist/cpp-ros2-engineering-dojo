# ============================================================================
#  cpp-ros2-dojo · code-server / VS Code 变体
#
#  定位：**基于 dojo:latest（主镜像，不含 vscode-server/插件）**，只叠加
#        code-server 与扩展，从而完整继承 base 的能力（C++20 / ROS 2 Jazzy /
#        Neovim+LazyVim / Pi+Claude Code+ECC / 现代 CLI+TUI / oh-my-zsh+tmux）。
#
#  base 现状：user `dev`(uid 1000) + `/home/dev` + `/work`。
#  本层为沿用 vscode/compose 约定，做三处对齐：
#    dev → user、/home/dev → /home/user、/work → /workspace（并保留 /work 软链）。
#
#  构建（必须先有 base，见 docker/build.sh）：
#    BASE_IMAGE=cpp-ros2-dojo:jazzy ./docker/build-vscode.sh
#  CI：先构建 base（:sha-<commit>），再以 BASE_IMAGE=该镜像构建本层。
# ============================================================================

ARG BASE_IMAGE=ghcr.io/embodist/cpp-ros2-engineering-dojo:latest
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
ARG CODE_SERVER_VERSION=4.143.1
ARG DEV_UID=1000
ARG DEV_GID=1000
ARG CURL_OPTS="--retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 20 --max-time 300"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER root

# ── 对齐 vscode 约定：dev→user，/home/dev→/home/user，/work→/workspace ──────
RUN set -eux; \
    if getent passwd dev >/dev/null && ! getent passwd user >/dev/null; then \
      usermod -l user -d /home/user -m dev; \
    fi; \
    if getent group dev >/dev/null && ! getent group user >/dev/null; then \
      groupmod -n user dev; \
    fi; \
    if [ -d /work ] && [ ! -e /workspace ]; then mv /work /workspace; else mkdir -p /workspace; fi; \
    ln -sfn /workspace /work; \
    echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/user; chmod 0440 /etc/sudoers.d/user; \
    echo 'user:user' | chpasswd; \
    usermod -aG sudo user 2>/dev/null || true; \
    if [ -d /home/user/.claude ]; then \
      grep -rIl '/home/dev' /home/user/.claude /home/user/.claude.json 2>/dev/null \
        | xargs -r sed -i 's#/home/dev#/home/user#g' || true; \
    fi; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user /workspace; \
    if [ -d /home/user/.claude ]; then \
      for p in $(runuser -u user -- env HOME=/home/user claude plugin list 2>/dev/null \
                   | grep -oE '[A-Za-z0-9._-]+@[A-Za-z0-9._-]+' | sort -u); do \
        runuser -u user -- env HOME=/home/user claude plugin enable "$p" >/dev/null 2>&1 || true; \
      done; \
    fi

# ── code-server ─────────────────────────────────────────────────────────────
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) debarch=amd64 ;; \
      arm64) debarch=arm64 ;; \
      *) echo "unsupported TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl $CURL_OPTS --max-time 900 -fsSL \
      "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${debarch}.deb" \
      -o /tmp/code-server.deb; \
    dpkg -i /tmp/code-server.deb || { apt-get update; apt-get -f install -y; dpkg -i /tmp/code-server.deb; }; \
    rm -f /tmp/code-server.deb; \
    code-server --version

# ── vscode 专属配置：覆盖 base 同名文件以适配 /workspace 与 user ─────────────
COPY vscode-zshrc /home/user/.zshrc
COPY mcp.vscode.json /home/user/.pi/agent/mcp.json
COPY claude.json /home/user/.claude.json
RUN set -eux; \
    chown "${DEV_UID}:${DEV_GID}" /home/user/.zshrc /home/user/.pi/agent/mcp.json /home/user/.claude.json; \
    chmod 0644 /home/user/.zshrc

# ── locale / timezone（沿用 zh_CN、Asia/Shanghai）────────────────────────────
RUN set -eux; \
    if command -v locale-gen >/dev/null 2>&1; then \
      sed -i 's/^# *\(zh_CN.UTF-8\)/\1/' /etc/locale.gen 2>/dev/null || true; \
      grep -q '^zh_CN.UTF-8' /etc/locale.gen 2>/dev/null || echo 'zh_CN.UTF-8 UTF-8' >> /etc/locale.gen; \
      locale-gen || true; \
      update-locale LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh || true; \
    fi; \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime || true; \
    echo Asia/Shanghai > /etc/timezone || true

# ── code-server 扩展（Open VSX；失败不阻塞构建）─────────────────────────────
RUN set -eu; \
    extensions="golang.go cnbcool.cnb-welcome formulahendry.code-runner ms-kubernetes-tools.vscode-kubernetes-tools tencent-cloud.coding-copilot github.github-vscode-theme ms-ceintl.vscode-language-pack-zh-hans eddieposey.vscode-icons-mac oderwat.indent-rainbow yzhang.markdown-all-in-one llvm-vs-code-extensions.vscode-clangd twxs.cmake eamodio.gitlens mhutchie.git-graph ms-python.python ms-vscode.cpptools ms-vscode.cmake-tools anthropic.claude-code"; \
    for ext in $extensions; do \
      if timeout 120 runuser -u user -- env HOME=/home/user code-server --disable-telemetry --install-extension "$ext" --force >/dev/null 2>&1; then \
        echo "OK extension $ext"; \
      else \
        echo "WARN extension $ext (not on Open VSX / network)"; \
      fi; \
    done; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user/.local/share/code-server 2>/dev/null || true

# ── 运行时 ──────────────────────────────────────────────────────────────────
ENV LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    TZ=Asia/Shanghai \
    SHELL=/usr/bin/zsh \
    EDITOR=nvim \
    VISUAL=nvim \
    PASSWORD=user \
    HOME=/home/user

USER user
WORKDIR /workspace
EXPOSE 8080
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "password", "--disable-telemetry", "--disable-workspace-trust", "/workspace"]
