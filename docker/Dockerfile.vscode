# ============================================================================
#  cpp-ros2-dojo · code-server / VS Code 变体
#  Debian 13.4 + code-server + C++ 工具链 + Neovim + AI + 现代 CLI/TUI
#
#  构建：
#    ./docker/build-vscode.sh
#  运行：
#    docker compose -f docker/compose.yaml --profile vscode up -d vscode
#    # 浏览器打开 http://localhost:8080，默认密码 user（请改）
#
#  注意：Debian 13 没有 ROS 2 Jazzy 包；需要 ROS 2 时用主 Dockerfile。
# ============================================================================

ARG BASE_IMAGE=debian:13.4
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG TARGETARCH
ARG CURL_OPTS="--retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 20 --max-time 300"

ARG NODE_VERSION=22.22.2
ARG NVIM_VERSION=v0.12.5
ARG LAZYGIT_VERSION=v0.44.1
ARG CODE_SERVER_VERSION=4.143.1
ARG PI_VERSION=0.85.1
ARG PI_MCP_ADAPTER_VERSION=2.7.2
ARG CLAUDE_CODE_VERSION=2.1.153

ARG YAZI_VERSION=v26.9.1
ARG JLESS_VERSION=v0.9.0
ARG JNV_VERSION=v0.7.1
ARG JSON_TUI_VERSION=v1.4.1
ARG BOTTOM_VERSION=0.14.9
ARG DUST_VERSION=v1.2.6
ARG GITUI_VERSION=v0.28.1
ARG XH_VERSION=v0.26.3
ARG STARSHIP_VERSION=v1.27.0
ARG GLOW_VERSION=v3.0.0
ARG PROCS_VERSION=v0.14.12

# 1 = 预装 Neovim 插件/Mason；0 = 首次打开 nvim 时再装
ARG INSTALL_PLUGINS=1
ARG INSTALL_MASON=1
ARG INSTALL_PREVIEW_DEPS=1
# 兼容 CI 统一传参（本镜像不安装 ROS 机器人库）
ARG INSTALL_ROBOTICS_LIBS=0

ARG DEV_UID=1000
ARG DEV_GID=1000

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ── apt：Debian 镜像 + 工具链 + 现代 CLI ────────────────────────────────────
RUN set -eux; \
    APT_OPTS="-o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0"; \
    if [ -n "${APT_MIRROR}" ]; then \
      if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i -E "s#https?://(deb|security)\.debian\.org#http://${APT_MIRROR}#g" \
          /etc/apt/sources.list.d/debian.sources; \
      fi; \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i -E "s#https?://(deb|security)\.debian\.org#http://${APT_MIRROR}#g" \
          /etc/apt/sources.list; \
      fi; \
    fi; \
    apt-get update $APT_OPTS; \
    apt-get install -y --no-install-recommends $APT_OPTS \
      wget unzip lsof nload htop net-tools bind9-dnsutils openssh-server \
      build-essential gcc g++ make pkg-config libssl-dev ca-certificates \
      clang clangd clang-tidy clang-format clang-tools lld lldb gdb \
      cmake ninja-build ccache cppcheck valgrind heaptrack \
      libasan8 libtsan2 libubsan1 \
      git git-lfs curl openssh-client gnupg lsb-release \
      ripgrep fd-find fzf bat jq git-delta hyperfine \
      duf btop eza zoxide sd just shellcheck shfmt ncdu \
      sqlite3 tealdeer \
      xz-utils zstd tar less man-db file tree \
      python3 python3-venv python3-pip python3-pytest pipx \
      tmux sudo zsh bash-completion locales tzdata \
      vim hx; \
    if [ "${INSTALL_PREVIEW_DEPS}" = "1" ]; then \
      apt-get install -y --no-install-recommends $APT_OPTS \
        ffmpeg imagemagick poppler-utils chafa 7zip; \
    fi; \
    ln -sf "$(command -v fdfind)" /usr/local/bin/fd; \
    if command -v batcat >/dev/null 2>&1; then \
      ln -sf "$(command -v batcat)" /usr/local/bin/bat; \
    fi; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*

# ── Node.js + AI CLI ────────────────────────────────────────────────────────
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) narch=x64 ;; \
      arm64) narch=arm64 ;; \
      *) echo "unsupported TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl $CURL_OPTS -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${narch}.tar.xz" \
      -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    printf '%s\n' \
      'registry=https://registry.npmmirror.com' \
      'audit=false' \
      'fund=false' \
      'fetch-retries=3' \
      'fetch-timeout=60000' > /etc/npmrc; \
    npm install -g --ignore-scripts --no-audit --no-fund "@earendil-works/pi-coding-agent@${PI_VERSION}"; \
    npm install -g --no-audit --no-fund "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm install -g --no-audit --no-fund "@modelcontextprotocol/server-filesystem@latest"; \
    npm cache clean --force; \
    rm -rf /root/.npm /tmp/*

# ── Neovim / lazygit / yq ───────────────────────────────────────────────────
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) narch=x86_64; larch=x86_64; yarch=amd64 ;; \
      arm64) narch=arm64;  larch=arm64;  yarch=arm64 ;; \
      *) echo "unsupported TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl $CURL_OPTS -fsSL "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-${narch}.tar.gz" \
      | tar -xz -C /opt; \
    ln -sf "/opt/nvim-linux-${narch}/bin/nvim" /usr/local/bin/nvim; \
    curl $CURL_OPTS -fsSL "https://github.com/jesseduffield/lazygit/releases/download/${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION#v}_Linux_${larch}.tar.gz" \
      | tar -xz -C /tmp lazygit; \
    install -m 0755 /tmp/lazygit /usr/local/bin/lazygit; \
    rm -f /tmp/lazygit; \
    curl $CURL_OPTS -fsSL "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${yarch}" \
      -o /usr/local/bin/yq; \
    chmod +x /usr/local/bin/yq; \
    nvim --version | head -1; lazygit --version; yq --version; \
    rm -rf /tmp/*

# ── 现代 CLI / TUI（GitHub 预编译）─────────────────────────────────────────
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) rustarch=x86_64; debarch=amd64 ;; \
      arm64) rustarch=aarch64; debarch=arm64 ;; \
      *) echo "unsupported TARGETARCH" >&2; exit 1 ;; \
    esac; \
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT; \
    curl $CURL_OPTS -fsSL "https://github.com/sxyazi/yazi/releases/download/${YAZI_VERSION}/yazi-${rustarch}-unknown-linux-musl.deb" -o "$tmp/yazi.deb"; \
    dpkg -i "$tmp/yazi.deb"; \
    curl $CURL_OPTS -fsSL "https://github.com/ClementTsang/bottom/releases/download/${BOTTOM_VERSION}/bottom-musl_${BOTTOM_VERSION}-1_${debarch}.deb" -o "$tmp/bottom.deb"; \
    dpkg -i "$tmp/bottom.deb"; \
    curl $CURL_OPTS -fsSL "https://github.com/charmbracelet/glow/releases/download/${GLOW_VERSION}/glow_${GLOW_VERSION#v}_${debarch}.deb" -o "$tmp/glow.deb"; \
    dpkg -i "$tmp/glow.deb"; \
    curl $CURL_OPTS -fsSL "https://github.com/bootandy/dust/releases/download/${DUST_VERSION}/dust-${DUST_VERSION}-${rustarch}-unknown-linux-musl.tar.gz" -o "$tmp/dust.tar.gz"; \
    tar -xzf "$tmp/dust.tar.gz" -C "$tmp"; \
    install -m 0755 "$tmp/dust-${DUST_VERSION}-${rustarch}-unknown-linux-musl/dust" /usr/local/bin/dust; \
    curl $CURL_OPTS -fsSL "https://github.com/ducaale/xh/releases/download/${XH_VERSION}/xh-${XH_VERSION}-${rustarch}-unknown-linux-musl.tar.gz" -o "$tmp/xh.tar.gz"; \
    tar -xzf "$tmp/xh.tar.gz" -C "$tmp"; \
    install -m 0755 "$tmp/xh-${XH_VERSION}-${rustarch}-unknown-linux-musl/xh" /usr/local/bin/xh; \
    curl $CURL_OPTS -fsSL "https://github.com/starship/starship/releases/download/${STARSHIP_VERSION}/starship-${rustarch}-unknown-linux-musl.tar.gz" -o "$tmp/starship.tar.gz"; \
    tar -xzf "$tmp/starship.tar.gz" -C "$tmp"; \
    install -m 0755 "$tmp/starship" /usr/local/bin/starship; \
    curl $CURL_OPTS -fsSL "https://github.com/dalance/procs/releases/download/${PROCS_VERSION}/procs-${PROCS_VERSION}-${rustarch}-linux.zip" -o "$tmp/procs.zip"; \
    unzip -q -o "$tmp/procs.zip" -d "$tmp/procs"; \
    install -m 0755 "$tmp/procs/procs" /usr/local/bin/procs; \
    curl $CURL_OPTS -fsSL "https://github.com/extrawurst/gitui/releases/download/${GITUI_VERSION}/gitui-linux-${rustarch}.tar.gz" -o "$tmp/gitui.tar.gz"; \
    tar -xzf "$tmp/gitui.tar.gz" -C "$tmp"; \
    install -m 0755 "$tmp/gitui" /usr/local/bin/gitui; \
    curl $CURL_OPTS -fsSL "https://github.com/ynqa/jnv/releases/download/${JNV_VERSION}/jnv-${rustarch}-unknown-linux-gnu.tar.xz" -o "$tmp/jnv.tar.xz"; \
    tar -xJf "$tmp/jnv.tar.xz" -C "$tmp"; \
    install -m 0755 "$tmp/jnv-${rustarch}-unknown-linux-gnu/jnv" /usr/local/bin/jnv; \
    if [ "${debarch}" = "amd64" ]; then \
      curl $CURL_OPTS -fsSL "https://github.com/PaulJuliusMartinez/jless/releases/download/${JLESS_VERSION}/jless-${JLESS_VERSION}-x86_64-unknown-linux-gnu.zip" -o "$tmp/jless.zip"; \
      unzip -q -o "$tmp/jless.zip" -d "$tmp/jless"; \
      install -m 0755 "$tmp/jless/jless" /usr/local/bin/jless; \
      curl $CURL_OPTS -fsSL "https://github.com/ArthurSonzogni/json-tui/releases/download/${JSON_TUI_VERSION}/json-tui-${JSON_TUI_VERSION#v}-Linux.deb" -o "$tmp/json-tui.deb"; \
      dpkg -i "$tmp/json-tui.deb"; \
    fi; \
    for t in yazi ya btm glow dust xh starship procs gitui jnv; do command -v "$t" >/dev/null; done; \
    if [ "${debarch}" = "amd64" ]; then command -v jless >/dev/null; command -v json-tui >/dev/null; fi; \
    rm -rf /tmp/*

# ── code-server ─────────────────────────────────────────────────────────────
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) debarch=amd64 ;; \
      arm64) debarch=arm64 ;; \
      *) echo "unsupported TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl $CURL_OPTS --max-time 900 -fsSL \
      "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${debarch}.deb" \
      -o /tmp/code-server.deb; \
    dpkg -i /tmp/code-server.deb || { apt-get update; apt-get -f install -y; dpkg -i /tmp/code-server.deb; }; \
    rm -f /tmp/code-server.deb; \
    code-server --version

# ── 用户 / 目录 ─────────────────────────────────────────────────────────────
RUN set -eux; \
    if ! getent group "${DEV_GID}" >/dev/null; then groupadd -g "${DEV_GID}" user; fi; \
    if getent passwd "${DEV_UID}" >/dev/null; then \
      existing="$(getent passwd "${DEV_UID}" | cut -d: -f1)"; \
      if [ "${existing}" != "user" ]; then usermod -l user -d /home/user -m "${existing}"; fi; \
    else \
      useradd -m -u "${DEV_UID}" -g "${DEV_GID}" -s /usr/bin/zsh user; \
    fi; \
    echo 'user:user' | chpasswd; \
    usermod -aG sudo user; \
    echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/user; \
    chmod 0440 /etc/sudoers.d/user; \
    mkdir -p /home/user /workspace; \
    chown "${DEV_UID}:${DEV_GID}" /home/user /workspace; \
    ln -sfn /workspace /work; \
    chsh -s /usr/bin/zsh user || true

# ── 配置快照（与主镜像共用 vendor 命名上下文）──────────────────────────────
COPY --from=nvim-config . /home/user/.config/nvim/
COPY --from=pi-config config/settings.json config/models.json /home/user/.pi/agent/
COPY --from=pi-config config/extensions/ /home/user/.pi/agent/extensions/
COPY --from=pi-config config/agents/ /home/user/.pi/agent/agents/
COPY --from=pi-config config/prompts/ /home/user/.pi/agent/prompts/
COPY --from=pi-config config/skills/ /home/user/.pi/agent/skills/
COPY --from=pi-config mcp-servers/ /opt/dotfiles.pi/mcp-servers/
COPY --from=pi-config tools/package.json tools/package-lock.json \
     tools/pi-autorun.js tools/claude-autorun.mjs /opt/dotfiles.pi/tools/
COPY --from=pi-config README.md PI_*.md /opt/dotfiles.pi/
COPY mcp.vscode.json /home/user/.pi/agent/mcp.json
COPY claude.json /home/user/.claude.json
COPY gitconfig /home/user/.gitconfig
COPY vscode-zshrc /home/user/.zshrc
COPY tmux.conf /tmp/dojo-tmux.conf

RUN set -eux; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user /opt/dotfiles.pi; \
    chmod 0644 /home/user/.zshrc

# ── Pi MCP 适配器 / autorun 依赖 ────────────────────────────────────────────
RUN timeout 900 runuser -u user -- env HOME=/home/user \
      pi install "npm:@cansiny0320/pi-mcp-adapter@${PI_MCP_ADAPTER_VERSION}" \
    && runuser -u user -- env HOME=/home/user pi list \
    && rm -rf /home/user/.npm /home/user/.cache /root/.npm /tmp/*

RUN cd /opt/dotfiles.pi/tools \
    && timeout 900 npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force \
    && chown -R "${DEV_UID}:${DEV_GID}" /opt/dotfiles.pi/tools \
    && rm -rf /root/.npm /home/user/.npm /tmp/*

# ── zsh / oh-my-zsh / tmux / helix（网络失败则保留回退配置）────────────────
RUN set -eux; \
    runuser -u user -- env HOME=/home/user git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
      clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git /home/user/.oh-my-zsh || true; \
    if runuser -u user -- bash -lc 'cd /home/user && git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 clone --depth=1 https://github.com/gpakosz/.tmux.git && ln -sf .tmux/.tmux.conf .tmux.conf && cp .tmux/.tmux.conf.local .'; then \
      :; \
    else \
      cp /tmp/dojo-tmux.conf /home/user/.tmux.conf; \
    fi; \
    runuser -u user -- env HOME=/home/user git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
      clone --depth=1 https://cnb.cool/fengxiaohong/helix_theme /home/user/.config/helix || true; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user

# ── locale / timezone ───────────────────────────────────────────────────────
RUN set -eux; \
    sed -i 's/^# *\(en_US.UTF-8\|zh_CN.UTF-8\)/\1/' /etc/locale.gen; \
    grep -q '^zh_CN.UTF-8' /etc/locale.gen || echo 'zh_CN.UTF-8 UTF-8' >> /etc/locale.gen; \
    locale-gen; \
    update-locale LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh; \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime; \
    echo Asia/Shanghai > /etc/timezone

# ── Neovim 插件 / Mason（可选）──────────────────────────────────────────────
RUN if [ "${INSTALL_PLUGINS}" = "1" ]; then \
      runuser -u user -- env HOME=/home/user git config --global http.lowSpeedLimit 1000; \
      runuser -u user -- env HOME=/home/user git config --global http.lowSpeedTime 60; \
      timeout 1800 runuser -u user -- env HOME=/home/user GIT_TERMINAL_PROMPT=0 NVIM_ENABLE_AI=1 \
        nvim --headless "+Lazy! restore" +qa \
      || timeout 1800 runuser -u user -- env HOME=/home/user GIT_TERMINAL_PROMPT=0 NVIM_ENABLE_AI=1 \
        nvim --headless "+Lazy! sync" +qa \
      || true; \
      timeout 900 runuser -u user -- env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
        nvim --headless "+TSUpdate" +qa || true; \
      if [ "${INSTALL_MASON}" = "1" ]; then \
        timeout 1800 runuser -u user -- env HOME=/home/user GIT_TERMINAL_PROMPT=0 \
          nvim --headless "+MasonInstall lua-language-server pyright vtsls bash-language-server json-lsp yamlls marksman cmake-language-server dockerfile-language-server stylua codelldb hadolint debugpy ruff prettier markdownlint-cli2 markdown-toc cmakelang cmakelint taplo" +qa \
          || true; \
      fi; \
      rm -rf /home/user/.cache /home/user/.npm \
             /home/user/.local/state/nvim/log \
             /home/user/.local/share/nvim/mason/.cache \
             /home/user/.local/share/nvim/mason/staging \
             /home/user/.local/share/nvim/mason/tmp \
             /root/.npm /tmp/*; \
    fi

# 修复 lazy.nvim 的两处网络遗留（与主镜像一致）
RUN set -eux; \
    LOCK=/home/user/.config/nvim/lazy-lock.json; \
    LAZY=/home/user/.local/share/nvim/lazy; \
    git config --global --add safe.directory '*'; \
    find "$LAZY" -maxdepth 1 -name '*.cloning' -exec rm -rf {} + 2>/dev/null || true; \
    if jq -e 'has("nvim-ufo")' "$LOCK" >/dev/null 2>&1; then \
      jq 'del(."nvim-ufo")' "$LOCK" > "$LOCK.tmp" && mv "$LOCK.tmp" "$LOCK"; \
    fi; \
    R="$LAZY/rainbow-delimiters.nvim"; \
    if [ -d "$R/.git" ]; then \
      rm -f "$R/.gitmodules"; \
      rm -rf "$R/test/bin" "$R/.luals/addons/busted" "$R/.luals/addons/luassert"; \
      git -C "$R" config --remove-section submodule..luals/addons/busted || true; \
      git -C "$R" config --remove-section submodule..luals/addons/luassert || true; \
      git -C "$R" config --remove-section submodule.test/bin || true; \
      commit="$(git -C "$R" rev-parse HEAD)"; \
      branch="$(git -C "$R" branch --show-current)"; branch="${branch:-master}"; \
      jq --arg c "$commit" --arg b "$branch" \
        '.["rainbow-delimiters.nvim"] = {"branch": $b, "commit": $c}' \
        "$LOCK" > "$LOCK.tmp" && mv "$LOCK.tmp" "$LOCK"; \
    fi; \
    chown "${DEV_UID}:${DEV_GID}" "$LOCK"; \
    rm -rf /home/user/.cache /home/user/.local/state/nvim/log /tmp/*

# ── code-server 扩展（Open VSX；失败不阻塞构建）────────────────────────────
RUN set -eu; \
    extensions="golang.go cnbcool.cnb-welcome formulahendry.code-runner ms-kubernetes-tools.vscode-kubernetes-tools tencent-cloud.coding-copilot github.github-vscode-theme ms-ceintl.vscode-language-pack-zh-hans eddieposey.vscode-icons-mac oderwat.indent-rainbow yzhang.markdown-all-in-one llvm-vs-code-extensions.vscode-clangd twxs.cmake eamodio.gitlens mhutchie.git-graph ms-python.python ms-vscode.cpptools ms-vscode.cmake-tools anthropic.claude-code"; \
    for ext in $extensions; do \
      if timeout 120 runuser -u user -- env HOME=/home/user code-server --disable-telemetry --install-extension "$ext" --force >/dev/null 2>&1; then \
        echo "OK extension $ext"; \
      else \
        echo "WARN extension $ext (not on Open VSX / network)"; \
      fi; \
    done; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user/.local/share/code-server 2>/dev/null || true

# ── oh-my-zsh / oh-my-tmux / TPM + 日常终端工具 ───────────────────────────
RUN set -eux; \
    APT_OPTS="-o Acquire::ForceIPv4=true -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=3 -o Acquire::http::Pipeline-Depth=0"; \
    apt-get update $APT_OPTS; \
    apt-get install -y --no-install-recommends $APT_OPTS \
      direnv entr strace tig asciinema rsync pv mtr-tiny xxd; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    clone3() { i=1; while [ "$i" -le 3 ]; do \
        runuser -u user -- env HOME=/home/user GIT_TERMINAL_PROMPT=0 git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
          clone --depth=1 "$1" "$2" && return 0; \
        i=$((i+1)); sleep 2; \
      done; return 1; }; \
    [ -d /home/user/.oh-my-zsh ] || clone3 https://github.com/ohmyzsh/ohmyzsh.git /home/user/.oh-my-zsh || true; \
    mkdir -p /home/user/.oh-my-zsh/custom/plugins; \
    [ -d /home/user/.oh-my-zsh/custom/plugins/zsh-autosuggestions ] || \
      clone3 https://github.com/zsh-users/zsh-autosuggestions /home/user/.oh-my-zsh/custom/plugins/zsh-autosuggestions || true; \
    [ -d /home/user/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting ] || \
      clone3 https://github.com/zsh-users/zsh-syntax-highlighting /home/user/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting || true; \
    if [ -f /home/user/.zshrc ]; then \
      sed -i 's/^plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting)/' /home/user/.zshrc; \
      grep -q 'direnv hook' /home/user/.zshrc || \
        echo 'command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"' >> /home/user/.zshrc; \
      grep -q 'alias t=' /home/user/.zshrc || \
        echo "alias t='tmux new -A -s main'" >> /home/user/.zshrc; \
    fi; \
    if [ ! -d /home/user/.tmux/.git ]; then \
      rm -rf /home/user/.tmux; \
      clone3 https://github.com/gpakosz/.tmux.git /home/user/.tmux || true; \
    fi; \
    if [ -f /home/user/.tmux/.tmux.conf ]; then \
      ln -sfn /home/user/.tmux/.tmux.conf /home/user/.tmux.conf; \
      cp /home/user/.tmux/.tmux.conf.local /home/user/.tmux.conf.local; \
    else \
      [ -f /home/user/.tmux.conf ] || cp /tmp/dojo-tmux.conf /home/user/.tmux.conf; \
      grep -q 'source-file ~/.tmux.conf.local' /home/user/.tmux.conf || \
        echo 'source-file ~/.tmux.conf.local' >> /home/user/.tmux.conf; \
      touch /home/user/.tmux.conf.local; \
    fi; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user/.tmux 2>/dev/null || true; \
    runuser -u user -- mkdir -p /home/user/.tmux/plugins; \
    for spec in \
      "tpm tmux-plugins/tpm" \
      "tmux-resurrect tmux-plugins/tmux-resurrect" \
      "tmux-continuum tmux-plugins/tmux-continuum" \
      "tmux-sensible tmux-plugins/tmux-sensible" \
      "tmux-fzf sainnhe/tmux-fzf"; do \
      set -- $spec; pname="$1"; prepo="$2"; \
      [ -d "/home/user/.tmux/plugins/$pname" ] || \
        clone3 "https://github.com/$prepo" "/home/user/.tmux/plugins/$pname" || true; \
    done; \
    if ! grep -q "^set -g @plugin 'tmux-plugins/tpm'" /home/user/.tmux.conf.local 2>/dev/null; then \
      printf '%s\n' \
        "set -g @plugin 'tmux-plugins/tpm'" \
        "set -g @plugin 'tmux-plugins/tmux-sensible'" \
        "set -g @plugin 'tmux-plugins/tmux-resurrect'" \
        "set -g @plugin 'tmux-plugins/tmux-continuum'" \
        "set -g @plugin 'sainnhe/tmux-fzf'" \
        "set -g @continuum-restore 'on'" \
        "set -g @continuum-save-interval '15'" \
        "set -g @resurrect-capture-pane-contents 'on'" \
        "run '~/.tmux/plugins/tpm/tpm'" \
        >> /home/user/.tmux.conf.local; \
    fi; \
    chown -R "${DEV_UID}:${DEV_GID}" /home/user/.oh-my-zsh /home/user/.tmux /home/user/.tmux.conf.local /home/user/.zshrc; \
    chown -h "${DEV_UID}:${DEV_GID}" /home/user/.tmux.conf; \
    rm -rf /home/user/.cache /home/user/.npm /tmp/*

# ── Mason LSP/工具补装（独立层，避免重跑插件 clone）────────────────────────
COPY mason-install.lua /opt/dojo/mason-install.lua
RUN if [ "${INSTALL_PLUGINS}" = "1" ] && [ "${INSTALL_MASON}" = "1" ]; then \
      timeout 1200 runuser -u user -- env HOME=/home/user \
        nvim --headless "+luafile /opt/dojo/mason-install.lua" || true; \
      rm -rf /home/user/.cache /home/user/.local/state/nvim/log /tmp/*; \
    fi

# ── 运行时 ──────────────────────────────────────────────────────────────────
ENV LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    TZ=Asia/Shanghai \
    SHELL=/usr/bin/zsh \
    EDITOR=nvim \
    VISUAL=nvim \
    PASSWORD=user

USER user
WORKDIR /workspace
EXPOSE 8080
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "--auth", "password", "--disable-telemetry", "--disable-workspace-trust", "/workspace"]
