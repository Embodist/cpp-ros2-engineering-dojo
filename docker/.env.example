# 复制为 docker/.env 后按需修改；不要提交 .env
# 训练营仓库绝对路径（必填）
DOJO_DIR=/absolute/path/to/cpp-ros2-engineering-dojo

# 配置来源（可选；默认使用仓库内 docker/vendor 快照）
# NVIM_CONFIG_DIR=/absolute/path/to/neovim.dotfiles/nvim
# PI_CONFIG_DIR=/absolute/path/to/dotfiles.pi

# 直接用公开镜像时设置（跳过本地 build）
# DOJO_IMAGE=ghcr.io/music-research-content/cpp-ros2-engineering-dojo:latest
# DOJO_IMAGE=registry.cn-chengdu.aliyuncs.com/rapid7/cpp-ros2-engineering-dojo:latest

# VS Code / code-server 变体
# VSCODE_IMAGE=ghcr.io/music-research-content/cpp-ros2-engineering-dojo:vscode
# VSCODE_IMAGE=registry.cn-chengdu.aliyuncs.com/rapid7/cpp-ros2-engineering-dojo:vscode
# VSCODE_PORT=8080
# VSCODE_PASSWORD=user
# VSCODE_BASE_IMAGE=cpp-ros2-dojo:jazzy   # 先构建 base（./docker/build.sh）
# CODE_SERVER_VERSION=4.143.1

# plus 版本只由 CI 构建（FROM base 追加工具），不在本地 build
# PLUS_IMAGE=ghcr.io/music-research-content/cpp-ros2-engineering-dojo:plus

# 与宿主机保持一致，避免挂载文件变 root 所有
DEV_UID=1000
DEV_GID=1000

# 构建选项
# BASE_IMAGE=ros:jazzy-ros-base
# BASE_IMAGE=osrf/ros:jazzy-desktop
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# INSTALL_PLUGINS=1
# INSTALL_MASON=1
# INSTALL_ROBOTICS_LIBS=0
# INSTALL_PREVIEW_DEPS=1   # yazi 的 ffmpeg/imagemagick/poppler/chafa/7zip 预览依赖
# INSTALL_ECC=1            # 构建期预装 ECC 插件（Claude Code，开箱即用）
# ECC_PRUNE_DEPS=1         # 裁掉 ECC 的 devDependencies（省体积；用到 web3/payment skill 时设 0）
# INSTALL_CLAUDE_OFFICIAL=1        # 额外预装官方 marketplace 的核心 Claude 工具
# CLAUDE_EXTRA_PLUGINS="superpowers@claude-plugins-official clangd-lsp@claude-plugins-official lua-lsp@claude-plugins-official pyright-lsp@claude-plugins-official pr-review-toolkit@claude-plugins-official code-review@claude-plugins-official code-simplifier@claude-plugins-official feature-dev@claude-plugins-official commit-commands@claude-plugins-official claude-code-setup@claude-plugins-official claude-md-management@claude-plugins-official skill-creator@claude-plugins-official explanatory-output-style@claude-plugins-official security-guidance@claude-plugins-official"

# AI 密钥（按需）
# MERAAI_API_KEY=sk-...
# ANTHROPIC_AUTH_TOKEN=sk-...
# ANTHROPIC_BASE_URL=https://api.meraai.cn
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# nvim AI 插件总开关；默认关闭，需要时改为 1
# NVIM_ENABLE_AI=1
# SEARXNG_URL=http://127.0.0.1:11199
