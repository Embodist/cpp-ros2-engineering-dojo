# ~/.zshrc — Dockerfile.vscode / code-server 容器
export LANG=zh_CN.UTF-8
export EDITOR=nvim
export VISUAL=nvim
export PATH="$HOME/.local/bin:$PATH"

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_DEFAULT_OPTS='--height 60% --layout=reverse --border --info=inline'
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -alF --icons=auto --group-directories-first --git'
  alias la='eza -a --icons=auto --group-directories-first'
  alias tree='eza --tree --icons=auto --group-directories-first'
fi
if command -v bat >/dev/null 2>&1; then
  alias cat='bat --style=plain --paging=never'
  export MANPAGER='bat --style=plain --paging=never -l man'
fi
command -v yazi >/dev/null 2>&1 && alias y='yazi'

alias gs='git status'

# ── uv 快捷（Python venv/依赖）──────────────────────────────────────────────
# uvvenv [目录=.venv] [python版本]  → 建 venv 并激活
uvvenv() { local dir="${1:-.venv}" py="${2:-}"; uv venv ${py:+--python "$py"} "$dir" && source "$dir/bin/activate"; }
alias uva='source .venv/bin/activate'
alias uvi='uv pip install'
alias uvl='uv pip list'
alias uvs='uv sync'
alias uvrun='uv run'
alias uvpy='uv python install'

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

cd /workspace 2>/dev/null || true
